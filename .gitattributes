# Text files are stored with LF, as everywhere else in this account.
* text=auto eol=lf

# The whole point of this repository is binary material. Git must never treat
# these as text: with core.autocrlf=true (the Windows default) a misdetected
# binary gets its line endings rewritten, which silently corrupts the file.
*.pdf   binary
*.doc   binary
*.docx  binary
*.xlsx  binary
*.xls   binary
*.pptx  binary
*.mp3   binary
*.m4a   binary
*.wav   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.zip   binary
